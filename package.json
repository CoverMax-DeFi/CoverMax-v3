  },
  "homepage": "https://github.com/zalatar242/CoverMax#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-toolbox": "^6.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@onflow/fcl": "^1.19.0",
    "@onflow/flow-cadut": "^0.2.0",
    "dotenv": "^17.0.1",
    "hardhat": "^2.25.0"
  },
